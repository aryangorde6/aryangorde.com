{# Every page extends this. `page` carries the per-page bits:
   title, description, path ("/" or "/slug/"), og (image path), lang_hi (bool). #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ page.title }}</title>
<meta name="description" content="{{ page.description }}" />
<meta name="theme-color" content="#0b0b0b" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230b0b0b'/%3E%3Crect x='5' y='20' width='22' height='7' fill='%23ffd60a'/%3E%3Cpath d='M9 18 15 4h2l6 14h-4l-1-3h-4l-1 3z' fill='%23f4f4f4'/%3E%3C/svg%3E" />
<meta name="color-scheme" content="dark" />
<link rel="canonical" href="{{ site.domain }}{{ page.path }}" />

<meta property="og:type" content="{{ 'website' if page.path == '/' else 'article' }}" />
<meta property="og:site_name" content="aryangorde.com" />
<meta property="og:title" content="{{ page.title }}" />
<meta property="og:description" content="{{ page.og_description }}" />
<meta property="og:url" content="{{ site.domain }}{{ page.path }}" />
<meta property="og:image" content="{{ site.domain }}{{ page.og }}" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="{{ page.og_alt }}" />
<meta name="twitter:card" content="summary_large_image" />

<link rel="preload" href="/{{ fonts['big-shoulders-latin'] }}" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/{{ fonts['newsreader-latin'] }}" as="font" type="font/woff2" crossorigin />
{% if page.get('hindi') %}<link rel="preload" href="/{{ fonts['anek-devanagari-names'] }}" as="font" type="font/woff2" crossorigin />
{% endif %}

<!--
  GENERATED FILE. Built by build.py from build_src/; edits here are overwritten.
  Edit build_src/content.py (words), build_src/templates/ (markup),
  build_src/static/css/site.css (design) or build_src/static/js/site.js (behaviour),
  then run: python3 build.py
-->

<script>
(function (d) {
  var r = d.documentElement;
  r.classList.add("js");
  if (window.matchMedia && matchMedia("(prefers-reduced-motion: no-preference)").matches) r.classList.add("motion");
})(document);
</script>

<style>
@font-face {
  font-family: "Big Shoulders Display";
  src: url(/{{ fonts['big-shoulders-latin'] }}) format("woff2");
  font-weight: 600 900;
  font-display: swap;
}
/* ₹ and arrows: not in the latin subset. */
@font-face {
  font-family: "Big Shoulders Display";
  src: url(/{{ fonts['big-shoulders-symbols'] }}) format("woff2");
  font-weight: 600 900;
  unicode-range: U+20B9, U+2190-2193, U+2197, U+2212;
  font-display: swap;
}
@font-face {
  font-family: "Newsreader";
  src: url(/{{ fonts['newsreader-latin'] }}) format("woff2");
  font-weight: 400 700;
  font-display: swap;
}
@font-face {
  font-family: "Newsreader";
  src: url(/{{ fonts['newsreader-symbols'] }}) format("woff2");
  font-weight: 400 700;
  unicode-range: U+20B9, U+2190-2193, U+2197, U+2212;
  font-display: swap;
}
/* Only the letters of the project names (a Google Fonts text= subset, 3 KB). */
@font-face {
  font-family: "Anek Devanagari";
  src: url(/{{ fonts['anek-devanagari-names'] }}) format("woff2");
  font-weight: 700;
  font-stretch: 75%;
  font-display: swap;
}

{{ css }}
</style>
{% block head_extra %}{% endblock %}
</head>

<body class="{{ page.get('body_class', '') }}">

<a class="skip-link" href="#main">Skip to content</a>

{% include "sections/nav.html.j2" %}

<main id="main" tabindex="-1">
{% block content %}{% endblock %}
</main>

{% include "sections/footer.html.j2" %}

<script>
{{ js }}
</script>

</body>
</html>
