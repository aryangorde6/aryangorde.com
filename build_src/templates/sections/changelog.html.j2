{% import "macros.html.j2" as m %}
<section class="section paper" id="changelog" aria-labelledby="changelog-title">
  <div class="wrap">
    {{ m.sec_head('changelog', 'Everything shipped', 'Final-year student, so no employment history yet. This is dated, shipped work, newest first.') }}
    <div class="log-grid">
      <ol class="log">
        {%- for e in changelog %}
        <li class="log-row">
          <p class="log-date">{{ e.period }}</p>
          <div class="log-body">
            <h3 class="log-name">{% if e.get('hindi') %}<span class="log-hi" lang="hi">{{ e.hindi }}</span> {% endif %}{{ e.name }}{% if e.get('prize') %} <span class="chip chip-ink">{{ e.prize }}</span>{% endif %}</h3>
            <p class="log-ctx">{{ e.context }}</p>
            <p class="log-detail">{{ e.detail }}</p>
            <p class="log-tech">{{ e.tech|join(' · ') }}</p>
            {%- if e.get('href') or e.get('links') %}
            <p class="log-links">
              {%- if e.get('href') %}<a class="text-link" href="{{ e.href }}">{{ 'The prize' if e.href.startswith('#') else 'Read the feature' }} {{ m.arr(e.href) }}</a>{% endif %}
              {%- for l in e.get('links', []) %}<a class="text-link" href="{{ l.href }}"{{ m.ext(l.href) }}>{{ l.label }} {{ m.arr(l.href) }}</a>{% endfor %}
            </p>
            {%- endif %}
          </div>
        </li>
        {%- endfor %}
      </ol>

      <aside class="log-side" aria-label="Education and certifications">
        <div class="side-block">
          <h3 class="side-head">Education</h3>
          <p class="side-strong">{{ education.degree }}</p>
          <p>{{ education.institution }}</p>
          <p class="side-dim">{{ education.affiliation }} · {{ education.status }}</p>
          <p class="side-text">{{ education.detail }}</p>
        </div>
        <div class="side-block">
          <h3 class="side-head">Certifications</h3>
          <ul class="certs">
            {%- for name, issuer, date in certifications %}
            <li><b>{{ name }}</b><span>{{ issuer }} · {{ date }}</span></li>
            {%- endfor %}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>
