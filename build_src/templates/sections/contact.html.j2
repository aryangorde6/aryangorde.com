{% import "macros.html.j2" as m %}
{# The back cover. The headline is the section's h2. #}
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 class="contact-head" id="contact-title">{{ contact.headline_pre }} <span class="ul">{{ contact.headline_mark }}</span></h2>
    <div class="contact-grid">
      <div>
        <p class="contact-body">{{ contact.body }}</p>
        <p class="mail-row">
          <a class="mail" href="mailto:{{ site.email }}">{{ site.email }}</a>
          <button type="button" class="btn btn-ink" data-copy="{{ site.email }}" hidden>Copy</button>
        </p>
        <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
      </div>
      <ul class="contact-links">
        {%- for l in contact.links %}
        <li><a href="{{ l.href }}"{{ m.ext(l.href) }}><b>{{ l.title }}</b><span>{{ l.note }}</span>{{ m.arr(l.href) }}</a></li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>
