{% import "macros.html.j2" as m %}
<section class="section" id="stack" aria-labelledby="stack-title">
  <div class="wrap">
    {{ m.sec_head('stack', 'Stack', 'The tools, by where they sit in a request.') }}
    <ol class="layers">
      {%- for s in stack %}
      <li class="layer">
        <h3 class="layer-name">{{ s.label }}</h3>
        <p class="layer-note">{{ s.note }}</p>
        {#- no-break spaces inside a tool's name, and the dot stays with the tool before it,
            so a line only ever breaks between tools #}
        <p class="layer-items">{{ s['items']|map('replace', ' ', '\u00a0')|join('\u00a0· ') }}</p>
      </li>
      {%- endfor %}
    </ol>
    <p class="langs"><span class="label">Written in</span> {{ languages|join(' · ') }}</p>
  </div>
</section>
