{% import "macros.html.j2" as m %}
<section class="section" id="about" aria-labelledby="about-title">
  <div class="wrap">
    {{ m.sec_head('about', 'About') }}
    <div class="about">
      <p class="about-lede">{{ about.lede }}</p>
      <div class="about-body">
        {%- for p in about.paragraphs %}
        <p>{{ p }}</p>
        {%- endfor %}
        <dl class="facts facts-dark">
          {%- for k, v in about.spec %}
          <div><dt>{{ k }}</dt><dd>{{ v }}</dd></div>
          {%- endfor %}
        </dl>
      </div>
    </div>
    <ul class="figs">
      {%- for f in figures %}
      <li><b>{{ f.value }}{{ f.suffix }}</b><span>{{ f.label }}</span></li>
      {%- endfor %}
    </ul>
  </div>
</section>
