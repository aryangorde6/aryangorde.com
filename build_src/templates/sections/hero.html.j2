{% import "macros.html.j2" as m %}
{# ===========================================================================
   §00 — the cover sheet. Big expanded type, the portrait set inline as a pill
   between the names, a dimension line, and the drawing's title block. On a
   fine pointer a CAD-style crosshair follows the cursor and the meta row
   reads out its coordinates.
   =========================================================================== #}
<section class="hero sheet-grid" id="top" tabindex="-1" aria-labelledby="hero-title">
  <div class="crosshair" aria-hidden="true"><span class="ch-x"></span><span class="ch-y"></span></div>

  <div class="wrap hero-wrap">
    <div class="meta-row rv" aria-hidden="true">
      <span>Sheet 00 — Index</span>
      <span class="meta-mid">{{ site.domain|replace('https://', '') }}</span>
      <span data-coords>19.08° N · 72.88° E</span>
    </div>

    <h1 class="hero-name rv" id="hero-title">
      <span class="hero-line">
        <span class="hero-word">{{ hero.first_name }}</span>
        <span class="hero-pill" aria-hidden="true">
          <picture>
            <source type="image/webp" srcset="{{ photo.webp_srcset }}" sizes="(min-width: 900px) 13vw, 60px" />
            <img src="{{ photo.fallback }}" srcset="{{ photo.jpg_srcset }}" sizes="(min-width: 900px) 13vw, 60px"
                 alt="" width="{{ photo.width }}" height="{{ photo.height }}" fetchpriority="high" decoding="async" />
          </picture>
        </span>
      </span>
      {# DOM order is name-then-aside so it reads "Aryan Gorde — backend…";
         CSS row-reverse puts the aside visually to the left of "Gorde". #}
      <span class="hero-line hero-line-2">
        <span class="hero-word">{{ hero.last_name }}</span>
        <span class="hero-aside">— {{ hero.kicker|lower }}</span>
      </span>
    </h1>

    <div class="dim rv" aria-hidden="true"><span class="dim-label">fig. 0 — the developer, drawn at 1:1</span></div>

    {# The year's results, straight under the name: one plate per prize, each
       stamped as it lands. The full story is on the Results sheet. #}
    <ul class="plates" aria-label="Hackathon prizes">
      {%- for r in results %}
      <li class="plate rv" style="--i: {{ loop.index0 }}">
        <a class="plate-link" href="{{ r.plate.href }}">
          <span class="plate-meta">Result {{ m.nn(loop.index) }} — {{ r.plate.month }}</span>
          <span class="plate-rank">{% if r.get('rank_lead') %}<span class="rank-lead">{{ r.rank_lead }}</span> {% endif %}{{ r.rank }}</span>
          <span class="plate-event">{{ r.event }}</span>
          <span class="plate-field"><span>{{ r.plate.org }}</span> · <span>{{ r.plate.field }}</span> · <span>{{ r.team|lower }}</span></span>
          <span class="plate-what">{{ r.plate.what }} <span class="arr" aria-hidden="true">↓</span></span>
        </a>
        {{ m.stamp(r.stamp[0], r.stamp[1], r.stamp[2], 'hero-' ~ r.id, r.rot) }}
      </li>
      {%- endfor %}
    </ul>
    {# A drawing note: the fixes merged into other people's projects. #}
    <a class="hero-note rv" href="#upstream">
      <span class="hn-key">Note 1</span>
      <span class="hn-text">Also merged upstream:
        {%- for u in upstream %} <b>{{ u.project }}</b> #{{ u.number }}{% if u.get('release') %} <span class="hn-dim">(shipped in {{ u.release }})</span>{% endif %}{% if not loop.last %} ·{% endif %}{% endfor %}</span>
      <span class="arr" aria-hidden="true">↓</span>
    </a>

    <div class="hero-grid">
      <div class="hero-intro rv">
        <p class="status-line"><span class="status-dot" aria-hidden="true"></span>{{ site.status }}</p>
        <p class="hero-blurb">{{ hero.blurb }}</p>
      </div>

      <div class="hero-actions rv">
        <a class="btn btn-primary" href="#results">See the prize-winning builds <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="{{ site.resume }}">Résumé, PDF <span class="arr arr-down" aria-hidden="true">↓</span></a>
        <a class="text-link" href="mailto:{{ site.email }}">{{ site.email }}</a>
      </div>

      <div class="hero-side rv">
      <div class="title-block">
        <p class="tb-head"><span>Title block</span><span>Rev. A</span></p>
        <dl class="tb-rows">
          {%- for field, value in hero.title_block %}
          <dt>{{ field }}</dt><dd>{{ value }}</dd>
          {%- endfor %}
        </dl>
      </div>
      </div>
    </div>
  </div>
</section>
