{% import "macros.html.j2" as m %}
{# Work: the four features. The first is the lead story; the other three share a row. #}
<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    {{ m.sec_head('work', 'Work', features|length ~ ' builds, each with its own page.') }}

    {% set lead = features[0] %}
    <article class="lead" aria-labelledby="t-{{ lead.slug }}">
      <div class="lead-media">
        {{ m.loop(videos[lead.video], '') }}
      </div>
      <div class="lead-text">
        <p class="chip">{{ lead.kicker }}</p>
        <h3 id="t-{{ lead.slug }}">{{ m.name(lead) }}</h3>
        {% if lead.get('gloss') %}<p class="gloss">“{{ lead.gloss }}”</p>{% endif %}
        <p class="teaser">{{ lead.teaser }}</p>
        <p class="lead-fig"><b>{{ lead.figures[0].value }}</b> {{ lead.figures[0].note }}</p>
        <a class="btn btn-solid" href="/{{ lead.slug }}/">Read the feature <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </article>

    <ul class="cards">
      {%- for f in features[1:] %}
      <li class="card">
        <article aria-labelledby="t-{{ f.slug }}">
          <div class="card-media">
            {%- if f.get('video') %}
            {{ m.loop(videos[f.video], '') }}
            {%- else %}
            {# No public video: the headline number stands in for one. #}
            <p class="card-stat" aria-hidden="true"><b>{{ f.figures[0].value }}</b><span>{{ f.figures[0].note }}</span></p>
            {%- endif %}
          </div>
          <h3 id="t-{{ f.slug }}"><a class="card-link" href="/{{ f.slug }}/">{{ m.name(f) }}</a></h3>
          <p class="card-kicker">{{ f.kicker }}</p>
          <p class="teaser">{{ f.teaser }}</p>
          <p class="card-more" aria-hidden="true">Read the feature →</p>
        </article>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
