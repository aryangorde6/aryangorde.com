{% import "macros.html.j2" as m %}
<section class="section" id="changelog" tabindex="-1" aria-labelledby="changelog-title">
  <div class="wrap">
    {{ m.sec_head(sec.changelog, 'changelog', 'Changelog', sheet_count, 'shipped work, newest first') }}

    <p class="sec-intro rv">Final-year computer engineering student, so no employment history yet —
      what follows is shipped, dated work.</p>

    <div class="log-grid">
      <ol class="log">
        {%- for e in changelog %}
        <li class="log-entry rv">
          <p class="log-date">{{ e.period }}</p>
          <div class="log-body">
            <p class="log-context"><span class="label">{{ e.context }}</span>{% if e.get('prize') %}<span class="log-prize">{{ e.prize }}</span>{% endif %}</p>
            <h3 class="log-name">{{ e.name }}</h3>
            <p class="log-detail">{{ e.detail }}</p>
            {{ m.chips(e.tech) }}
            {% if e.anchor or e.get('links') %}
            <p class="log-links">
              {%- if e.anchor %}<a class="text-link" href="#{{ e.anchor }}">{{ 'The result' if e.anchor in ['rote'] else 'Read the write-up' }} <span aria-hidden="true">↑</span></a>{% endif %}
              {%- for l in e.get('links', []) %}<a class="text-link" href="{{ l.href }}"{{ m.ext(l.href) }}>{{ l.label }} <span aria-hidden="true">↗</span></a>{% endfor %}
            </p>
            {% endif %}
          </div>
        </li>
        {%- endfor %}
      </ol>

      <aside class="log-side" aria-label="Education and certifications">
        <div class="card rv">
          <p class="label">Education · {{ education.status }}</p>
          <h3 class="card-title">{{ education.degree }}</h3>
          <p class="card-strong">{{ education.institution }}</p>
          <p class="card-muted">{{ education.affiliation }}</p>
          <p class="card-text">{{ education.detail }}</p>
        </div>

        <div class="card rv">
          <p class="label">{{ certifications|length }} completed</p>
          <h3 class="card-title">Certifications</h3>
          <ul class="certs">
            {%- for name, issuer, date in certifications %}
            <li><span class="cert-name">{{ name }}</span><span class="cert-meta">{{ issuer }} · {{ date }}</span></li>
            {%- endfor %}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>
