{# Fixed along the top. On the home page the links are in-page anchors; on a
   feature page they lead back to the same sections of the home page. #}
{% set base = '' if page.path == '/' else '/' %}
<header class="nav" data-nav>
  <div class="nav-inner">
    <a class="nav-site" href="/">aryangorde.com</a>
    <nav class="nav-links" aria-label="Sections">
      {%- for id, label in nav %}
      <a href="{{ base }}#{{ id }}">{{ label }}</a>
      {%- endfor %}
    </nav>
    <a class="nav-cv" href="{{ site.resume }}">Résumé <span aria-hidden="true">↓</span></a>
  </div>
</header>
