{% import "macros.html.j2" as m %}
{# ===========================================================================
   Results — the hackathons. Prizes get a card each with a rubber stamp (the
   "approved" stamp a drawing gets in its title block); every other entry is
   logged underneath, with an outcome column that claims nothing it can't.
   =========================================================================== #}
<section class="section results-sheet" id="results" tabindex="-1" aria-labelledby="results-title">
  <div class="wrap">
    {{ m.sec_head(sec.results, 'results', 'Results', sheet_count, results|length ~ ' hackathon prizes, both solo, and ' ~ upstream|length ~ ' fixes merged upstream — 2026') }}

    <div class="results-grid">
      {%- for r in results %}
      <article class="result rv" id="{{ r.id }}" tabindex="-1" aria-labelledby="{{ r.id }}-title">
        {{ m.stamp(r.stamp[0], r.stamp[1], r.stamp[2], r.id, r.rot) }}
        <p class="label">{{ r.organizer }} · {{ r.dates }}</p>
        <h3 class="result-event" id="{{ r.id }}-title">{{ r.event }}</h3>
        <p class="result-rank">{% if r.get('rank_lead') %}<span class="rank-lead">{{ r.rank_lead }}</span> {% endif %}{{ r.rank }}</p>
        <p class="result-field">{{ r.field }}</p>
        <p class="result-build"><b>{{ r.build }}</b> — {{ r.summary }}</p>
        <dl class="result-meta">
          <div><dt>Track</dt><dd>{{ r.track }}</dd></div>
          <div><dt>Prize</dt><dd>{{ r.prize }}</dd></div>
          <div><dt>Team</dt><dd>{{ r.team }}</dd></div>
        </dl>
        {%- if r.get('proof') %}
        {# The organisers' own graphic, cropped to its header and this row. The
           break line marks where the other winners were cut out. #}
        <figure class="proof">
          {%- for part in r.proof.parts %}
          {% set a = awards[part.name] %}
          {%- if not loop.first %}
          <span class="proof-break" aria-hidden="true"><svg class="proof-zig" viewBox="0 0 28 14" focusable="false"><path d="M0 7h9l3-6 4 12 3-6h9" /></svg></span>
          {%- endif %}
          <picture class="proof-part" style="--w: {{ a.pct }}%">
            <source type="image/webp" srcset="{{ a.webp }}" />
            <img src="{{ a.jpg }}" alt="{{ part.alt }}" width="{{ a.w }}" height="{{ a.h }}" loading="lazy" decoding="async" />
          </picture>
          {%- endfor %}
          <figcaption class="fig-cap">
            <span><b>Detail</b> — {{ r.proof.caption }}</span>
            {%- if r.proof.get('post') %}
            <a class="text-link proof-post" href="{{ r.proof.post }}"{{ m.ext(r.proof.post) }}>See WeMakeDevs’ original post on LinkedIn <span aria-hidden="true">↗</span></a>
            {%- endif %}
          </figcaption>
        </figure>
        {%- endif %}
        <div class="btn-row">
          {%- for link in r.links %}
          <a class="btn btn-sm {{ 'btn-primary' if loop.first else 'btn-ghost' }}" href="{{ link.href }}"{{ m.ext(link.href) }}>{{ link.label }} <span class="arr" aria-hidden="true">{{ '↓' if link.href.startswith('#') else '↗' }}</span></a>
          {%- endfor %}
        </div>
      </article>
      {%- endfor %}
    </div>

    {# Merged upstream: the drawing's revision block — changes someone else
       reviewed and accepted into their own project. #}
    <div class="upstream rv" id="upstream" tabindex="-1">
      <h3 class="entries-title">Merged upstream</h3>
      <div class="upstream-grid">
        {%- for u in upstream %}
        <article class="pr" id="{{ u.id }}" tabindex="-1" aria-labelledby="{{ u.id }}-title">
          <p class="pr-head"><span>{{ u.repo }}</span><span class="pr-tag">Merged</span></p>
          <h4 class="pr-project" id="{{ u.id }}-title">{{ u.project }} <span class="pr-num">#{{ u.number }}</span></h4>
          <p class="pr-title">{{ u.title }}</p>
          <p class="pr-summary">{{ u.summary }}</p>
          <dl class="pr-meta">
            <div><dt>Merged</dt><dd>{{ u.merged }}</dd></div>
            <div><dt>Diff</dt><dd>{{ u.diff }}</dd></div>
            <div><dt>Status</dt><dd>{{ u.status }}</dd></div>
          </dl>
          <a class="btn btn-sm btn-ghost pr-link" href="{{ u.href }}"{{ m.ext(u.href) }}>View the pull request <span class="arr" aria-hidden="true">↗</span></a>
        </article>
        {%- endfor %}
      </div>
    </div>

    <div class="entries rv">
      <h3 class="entries-title">Also entered in 2026</h3>
      <table class="entries-table">
        <thead>
          <tr><th scope="col">When</th><th scope="col">Hackathon</th><th scope="col">What I built</th><th scope="col">Outcome</th></tr>
        </thead>
        <tbody>
          {%- for e in entries %}
          <tr>
            <td class="ent-when">{{ e.when }}</td>
            <td class="ent-event"><b>{{ e.event }}</b>{% if e.organizer %}<span>{{ e.organizer }}</span>{% endif %}</td>
            <td class="ent-build">{{ e.build }}</td>
            <td class="ent-outcome">{{ e.outcome }}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>
