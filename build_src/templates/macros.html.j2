{# Small pieces every page draws the same way. #}

{# rel/target for anything that leaves the site. #}
{% macro ext(href) %}{% if href.startswith('http') %} target="_blank" rel="noopener"{% endif %}{% endmacro %}

{# The arrow that says where a link goes: down the page, to another page, or off-site. #}
{% macro arr(href) %}<span class="arr" aria-hidden="true">{{ '↓' if href.startswith('#') else ('↗' if href.startswith('http') else '→') }}</span>{% endmacro %}

{% macro chips(items) %}
<ul class="chips">
  {%- for item in items %}<li>{{ item }}</li>{% endfor -%}
</ul>
{% endmacro %}

{# A department header: a heavy rule, the title, one line under it. #}
{% macro sec_head(id, title, dek='') %}
<header class="sec-head">
  <h2 class="sec-title" id="{{ id }}-title">{{ title }}</h2>
  {% if dek %}<p class="sec-dek">{{ dek }}</p>{% endif %}
</header>
{% endmacro %}

{# A row of links: the first is the solid one. #}
{% macro buttons(links, extra='') %}
<p class="btn-row{% if extra %} {{ extra }}{% endif %}">
  {%- for l in links %}
  <a class="btn{{ ' btn-solid' if loop.first else '' }}" href="{{ l.href }}"{{ ext(l.href) }}>{{ l.label }} {{ arr(l.href) }}</a>
  {%- endfor %}
</p>
{% endmacro %}

{# A silent loop from a demo recording. The poster is a real <img> so it can
   lazy-load; the video loads nothing until script plays it on screen. With
   reduced motion it waits for the Play button. Without script: the poster. #}
{% macro loop(v, alt, eager=False) %}
<div class="loop" data-loop>
  <img class="loop-poster" src="/{{ v.poster }}" alt="{{ alt }}" width="{{ v.w }}" height="{{ v.h }}"{% if not eager %} loading="lazy"{% endif %} decoding="async" />
  <video class="loop-video" muted loop playsinline preload="none" width="{{ v.w }}" height="{{ v.h }}" aria-hidden="true" tabindex="-1">
    <source src="/{{ v.mp4 }}" type="video/mp4" />
  </video>
  <button class="loop-btn" type="button" data-loop-btn hidden>Pause</button>
</div>
{% endmacro %}

{# The project name as set in a headline: Devanagari over the Latin, when it has one. #}
{% macro name(f, tag='span', cls='') %}
<{{ tag }} class="pname{% if cls %} {{ cls }}{% endif %}">
  {%- if f.get('hindi') %}<span class="pname-hi" lang="hi">{{ f.hindi }}</span>{% endif -%}
  <span class="pname-en">{{ f.name }}</span>
</{{ tag }}>
{% endmacro %}
