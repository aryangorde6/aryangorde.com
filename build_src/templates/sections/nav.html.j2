{% import "macros.html.j2" as m %}
<header class="nav">
  <div class="nav-inner">
    <a class="brand" href="#top" aria-label="{{ site.name }} — back to top">
      <span class="brand-mark" aria-hidden="true">AG</span>
      <span class="brand-name">{{ site.name }}</span>
    </a>

    <nav class="nav-links-wrap" aria-label="Primary">
      <ol class="nav-links">
        {%- for id, label in nav %}
        <li><a class="nav-link" href="#{{ id }}" data-nav="{{ id }}"><span class="nav-num">{{ m.nn(loop.index) }}</span>{{ label }}</a></li>
        {%- endfor %}
      </ol>
    </nav>

    <div class="nav-end">
      <span class="status"><span class="status-dot" aria-hidden="true"></span>Available</span>
      {# The command menu is JS-only, so the button only appears with .js #}
      <button type="button" class="menu-btn" data-palette-open aria-haspopup="dialog" aria-controls="palette">
        <span class="menu-label">Menu</span><kbd class="kbd" data-kbd>⌘K</kbd>
      </button>
    </div>
  </div>
  <div class="progress" aria-hidden="true"></div>
</header>
